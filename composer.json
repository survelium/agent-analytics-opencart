{
    "name": "survelium/agent-analytics-opencart",
    "description": "Report AI crawlers and AI-referred visitors on an OpenCart shop to Survelium, through auto_prepend_file.",
    "keywords": [
        "survelium",
        "opencart",
        "ai-crawlers",
        "agent-analytics"
    ],
    "homepage": "https://github.com/survelium/agent-analytics-opencart",
    "license": "MIT",
    "authors": [
        {
            "name": "Catalin Prodan",
            "email": "catalin.prodan@newpixel.ro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "survelium/agent-analytics-php": "^0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/survelium/agent-analytics-php"
        }
    ],
    "autoload": {
        "psr-4": {
            "Survelium\\AgentAnalyticsOpenCart\\": "src"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
